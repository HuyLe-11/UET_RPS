# Local laptop defaults. Secrets belong in the project root .env or data/.env.
# Shell environment variables and root/data .env values override these values.
OTT_SCORING_PORT=8110
OTT_SCORING_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://uet-rps-i11s.vercel.app
OTT_SCORING_BOT_DIR=./data/storage/submissions
OTT_SCORING_WORKERS=2
OTT_SCORING_QUEUE_SIZE=20

# Judge0 remains local and private on port 2358; the scoring API uses 8110.
OTT_JUDGE0_URL=q
OTT_JUDGE0_PYTHON_ID=71
OTT_JUDGE0_CPU_SECONDS=30
OTT_JUDGE0_MAX_SECONDS=140
OTT_JUDGE0_MEMORY_KB=262144

# Frontend dev server setting (set when starting Vite, not read by this module):
# VITE_SCORING_MODULE_URL=http://127.0.0.1:8110
