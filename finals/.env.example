# Môi trường chung kết
# Copy file này thành .env và điền giá trị thực

# PostgreSQL
FINALS_DB_HOST=localhost
FINALS_DB_PORT=5432
FINALS_DB_NAME=finals
FINALS_DB_USER=postgres
FINALS_DB_PASSWORD=CHANGE_ME

# Server
FINALS_PORT=9000
FINALS_ADMIN_SECRET=CHANGE_ME_ADMIN

# Cấp log console (DEBUG / INFO / WARNING)
FINALS_LOG_LEVEL=INFO

# Số worker chạy trận song song (mặc định = số CPU)
FINALS_MAX_WORKERS=4

# Kích thước hàng đợi tối đa
FINALS_QUEUE_SIZE=200
